# ============================================================================
#  FILE MÔI TRƯỜNG — Sao chép thành .env rồi chỉnh sửa
#  cp .env.example .env && chmod 600 .env
#
#  ⚠️  .env KHÔNG BAO GIỜ commit lên git. Xem .gitignore
#  ⚠️  Mật khẩu nhạy cảm nằm trong secrets/*.txt, KHÔNG đặt ở đây
# ============================================================================

# ---------------------------------------------------------------- HỆ THỐNG
COMPOSE_PROJECT_NAME=qlpt
TZ=Asia/Ho_Chi_Minh
LOG_LEVEL=INFO
DOMAIN=qlpt.local
PUBLIC_IP=203.0.113.10          # ← ĐỔI thành IP server thật của bạn

# ---------------------------------------------------------------- CƠ SỞ DỮ LIỆU
DB_USER=qlpt
# DB_PASSWORD nằm trong secrets/db_password.txt (tự sinh bởi bootstrap script)
DB_PORT=5432
POSTGRES_VERSION=16

REDIS_PASSWORD=doi-mot-mat-khau-redis-dai-toi-32-ky-tu-ngau-nhien_2026
RABBITMQ_USER=qlpt
# Mật khẩu RabbitMQ — deploy script tự ghi vào từ secrets/rabbitmq_password.txt
RABBITMQ_DEFAULT_PASS=

# ---------------------------------------------------------------- BẢO MẬT
# JWT_SECRET nằm trong secrets/jwt_secret.txt
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
CORS_ORIGINS=https://qlpt.local,http://localhost:5173
RATE_LIMIT_PER_MINUTE=100

# ---------------------------------------------------------------- OBJECT STORAGE
MINIO_ROOT_USER=qlptadmin
# MINIO_ROOT_PASSWORD nằm trong secrets/minio_root_password.txt
MINIO_BUCKET=qlpt-media
MINIO_EXTERNAL_ENDPOINT=minio.qlpt.local:9000

# ---------------------------------------------------------------- GỬI THÔNG BÁO
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ZALO_OA_ID=
# Bật khi thật sự gửi; "false" => ghi log vào db_notify (an toàn khi demo)
NOTIFICATION_DRY_RUN=true

# ---------------------------------------------------------------- GIÁ DỊCH VỤ
# (Ghi đè mặc định trong seed data)
DEFAULT_ELECTRIC_TIER1_PRICE=1800
DEFAULT_WATER_PRICE=15000
DEFAULT_INTERNET_FEE=100000
DEFAULT_CLEANING_FEE=50000
DEFAULT_TRASH_FEE=20000

# ---------------------------------------------------------------- GIÁM SÁT
GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD nằm trong secrets/admin_password.txt
LOG_RETENTION_DAYS=15

# ---------------------------------------------------------------- HIỆU NĂNG
UVICORN_WORKERS=1
SQL_POOL_SIZE=10
SQL_MAX_OVERFLOW=10
RABBITMQ_PREFETCH=10
OUTBOX_POLL_INTERVAL=5
